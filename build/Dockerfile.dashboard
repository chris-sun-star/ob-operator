FROM node:18-alpine AS builder-fe
WORKDIR /workspace
# Copy pre-installed node_modules from host to avoid container proxy issues
COPY ./ui/node_modules ./node_modules
COPY ./ui .
ENV NODE_OPTIONS=--max_old_space_size=5120
RUN yarn build

FROM golang:1.25 AS builder-be
ARG GOPROXY=https://goproxy.io,direct
ARG GOSUMDB=sum.golang.org
ARG COMMIT_HASH=unknown
WORKDIR /workspace
# Copy prebuilt swag and go-bindata binaries to bypass network go install
COPY build/bin/swag /go/bin/swag
COPY build/bin/go-bindata /go/bin/go-bindata
COPY . .
RUN make dashboard-dep-install
RUN swag --version
RUN make dashboard

# start build docker image
FROM registry.access.redhat.com/ubi9/ubi:9.8
ARG VERSION
LABEL name="oceanbase-dashboard" \
      vendor="OceanBase" \
      version=${VERSION} \
      release="1" \
      summary="OceanBase dashboard" \
      description="Kubernetes dashboard for OceanBase" \
      maintainer="OceanBase"
WORKDIR /opt
RUN mkdir -p /licenses
COPY LICENSE /licenses
COPY --from=builder-be /workspace/bin/oceanbase-dashboard .
COPY --from=builder-fe /workspace/dist ./ui/dist
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime
RUN yum update -y && yum install -y procps-ng mariadb && yum clean all
USER 65534:65534
ENTRYPOINT ["/opt/oceanbase-dashboard"]
