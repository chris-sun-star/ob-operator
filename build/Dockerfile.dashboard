FROM node:18-alpine AS builder-fe
WORKDIR /workspace
COPY ./ui .
ENV NODE_OPTIONS=--max_old_space_size=5120
RUN yarn
RUN yarn build

FROM golang:1.25 AS builder-be
ARG GOPROXY=https://goproxy.io,direct
ARG GOSUMDB=sum.golang.org
ARG COMMIT_HASH=unknown
WORKDIR /workspace
COPY . .
RUN make dashboard-dep-install
RUN swag --version
RUN make dashboard

# start build docker image
FROM registry.access.redhat.com/ubi8/ubi:8.10
ARG VERSION
LABEL name="oceanbase-dashboard" \
      vendor="OceanBase" \
      version=${VERSION} \
      release="1" \
      summary="OceanBase dashboard" \
      description="Kubernetes dashboard for OceanBase" \
      maintainer="OceanBase"
WORKDIR /opt
RUN mkdir -p /licenses
COPY LICENSE /licenses
COPY --from=builder-be /workspace/bin/oceanbase-dashboard .
COPY --from=builder-fe /workspace/dist ./ui/dist
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime
RUN yum install -y mysql && yum clean all
USER 65534:65534

ENTRYPOINT ["/root/oceanbase-dashboard"]
